generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


model Site {

  id Int @id @default(autoincrement())

  name String

  url String @unique

  domain String

  icon String?

  description String?

  category String?

  tags String?

  createdAt DateTime @default(now())

}