generator client {
  provider = "prisma-client-js"
}


datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}





model Site {

  id Int @id(map: "Site_pkey") @default(autoincrement())


  name String


  url String @unique(map: "Site_url_key")


  domain String


  icon String?


  description String?


  category String?


  tags String[]


  createdAt DateTime @default(now())


  @@map("site")

}







model EnglishWord {


  id Int @id @default(autoincrement())


  // Emoji，例如 🌱 🚀 🔥

  emoji String



  // 英语单词

  word String



  // 音标

  pronunciation String?



  // 英文例句

  example String



  // 中文翻译

  translation String



  // 是否掌握

  mastered Boolean @default(false)



  createdAt DateTime @default(now())


  @@map("english_word")

}